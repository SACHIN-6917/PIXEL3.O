# PIXEL 3.O — Environment Variables Template
# Copy this file to .env or .env.local and populate with your environment deployment values

# Google Apps Script Web App Endpoint for PIXEL 3.O Registration & Admin Sync
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Official UPI Payment ID (e.g. gokulkumar1406@okaxis)
VITE_UPI_ID=gokulkumar1406@okaxis

# Official WhatsApp Support / Community Group
VITE_WHATSAPP_LINK=https://chat.whatsapp.com/YOUR_GROUP_INVITE_CODE
